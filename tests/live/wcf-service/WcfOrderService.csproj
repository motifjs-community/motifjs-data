<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- A WCF service (CoreWCF) for the SoapAdapter live tests: npm run test:live builds and starts it. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Shop</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CoreWCF.Http" Version="1.9.1" />
    <PackageReference Include="CoreWCF.Primitives" Version="1.9.1" />
  </ItemGroup>

</Project>
